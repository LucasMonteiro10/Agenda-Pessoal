# Copie este arquivo para ".env" e ajuste os valores localmente.
# O ".env" nunca deve ser commitado (já está no .gitignore).

# --- Banco de dados (Postgres + Adminer) ---
POSTGRES_DB=agenda
POSTGRES_USER=agenda_user
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432
ADMINER_PORT=8081

# --- Backend (NestJS) ---
# Dentro do Docker Compose, o backend fala com o Postgres pelo nome do
# serviço ("postgres"), não por "localhost".
POSTGRES_HOST=postgres
BACKEND_PORT=3000
JWT_SECRET=changeme-em-producao

# --- Frontend (React + Vite) ---
FRONTEND_PORT=5173
# URL que o backend usa para liberar CORS para o frontend.
FRONTEND_URL=http://localhost:5173
# URL que o frontend usa para chamar o backend (injetada em build/dev pelo Vite).
VITE_API_URL=http://localhost:3000
