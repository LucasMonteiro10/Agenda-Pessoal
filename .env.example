# Copie este arquivo para ".env" e ajuste os valores localmente.
# O ".env" nunca deve ser commitado (já está no .gitignore).

# --- Banco de dados (Postgres + Adminer) ---
POSTGRES_DB=agenda
POSTGRES_USER=agenda_user
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432
ADMINER_PORT=8081

# Produção (Vercel + Neon): em vez das variáveis acima, o backend usa
# DATABASE_URL (criada pela integração do Neon), com SSL. Não defina
# DATABASE_URL no .env local — ela tem prioridade sobre as POSTGRES_*.
# DATABASE_URL=postgresql://usuario:senha@ep-exemplo.neon.tech/agenda?sslmode=require

# --- Backend (NestJS) ---
# Dentro do Docker Compose, o backend fala com o Postgres pelo nome do
# serviço ("postgres"), não por "localhost".
POSTGRES_HOST=postgres
BACKEND_PORT=3000
JWT_SECRET=changeme-em-producao

# --- Frontend (React + Vite) ---
FRONTEND_PORT=5173
# Origem(ns) que o backend libera no CORS. Aceita várias, separadas por
# vírgula, e "*" para as URLs de preview da Vercel, ex.:
# FRONTEND_URL=https://agenda-pessoal.vercel.app,https://agenda-pessoal-*-seu-usuario.vercel.app
FRONTEND_URL=http://localhost:5173
# URL que o frontend usa para chamar o backend (injetada em build/dev pelo Vite).
VITE_API_URL=http://localhost:3000
